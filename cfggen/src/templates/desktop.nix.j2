{%- if needs_xserver %}
  services.xserver.enable = true;
{%- endif %}
{%- if desktop == "plasma" %}
  services.desktopManager.plasma6.enable = true;
{%- elif desktop == "gnome" %}
  services.desktopManager.gnome.enable = true;
{%- elif desktop == "xfce" %}
  services.xserver.desktopManager.xfce.enable = true;
{%- elif desktop == "cinnamon" %}
  services.xserver.desktopManager.cinnamon.enable = true;
{%- elif desktop == "mate" %}
  services.xserver.desktopManager.mate.enable = true;
{%- elif desktop == "cosmic" %}
  services.desktopManager.cosmic.enable = true;
{%- elif desktop == "wayfire" %}
  programs.wayfire.enable = true;
{%- elif desktop == "openbox" %}
  services.xserver.windowManager.openbox.enable = true;
{%- elif desktop == "lxqt" %}
  services.xserver.desktopManager.lxqt.enable = true;
{%- elif desktop == "fluxbox" %}
  services.xserver.windowManager.fluxbox.enable = true;
{%- elif desktop == "enlightenment" %}
  services.xserver.desktopManager.enlightenment.enable = true;
{%- elif desktop == "labwc" %}
  programs.labwc.enable = true;
{%- elif desktop == "pantheon" %}
  services.desktopManager.pantheon.enable = true;
{#- Tiling WMs also get what their default configs launch; sway's and i3's modules already ship it. #}
{%- elif desktop == "niri" %}
  programs.niri.enable = true;
  # X11 apps run through xwayland-satellite, which niri spawns from PATH.
{%- set wm_packages = "xwayland-satellite alacritty fuzzel swaylock" %}
{%- elif desktop == "mango" %}
{%- set wm_packages = "mango foot rofi" %}
{%- elif desktop == "hyprland" %}
  programs.hyprland.enable = true;
{%- set wm_packages = "kitty kdePackages.dolphin hyprlauncher" %}
{%- elif desktop == "i3" %}
  services.xserver.windowManager.i3.enable = true;
{%- elif desktop == "sway" %}
  programs.sway.enable = true;
{%- elif desktop == "bspwm" %}
  services.xserver.windowManager.bspwm = {
    enable = true;
    # Both default to missing $HOME files, leaving no keybindings; use bspwm's packaged examples.
    configFile = "${pkgs.bspwm}/share/doc/bspwm/examples/bspwmrc";
    sxhkd.configFile = "${pkgs.bspwm}/share/doc/bspwm/examples/sxhkdrc";
  };
{%- set wm_packages = "rxvt-unicode dmenu" %}
{%- elif desktop == "xmonad" %}
  services.xserver.windowManager.xmonad.enable = true;
{%- set wm_packages = "dmenu" %}
{%- elif desktop == "dwm" %}
  services.xserver.windowManager.dwm.enable = true;
{%- set wm_packages = "st dmenu" %}
{%- endif %}
{%- if desktop_is_tiling %}
  security.polkit.enable = true;

  # Polkit without an agent means a GUI authentication prompt never appears at all.
  systemd.user.services.balsa-polkit-agent = {
    description = "Polkit authentication agent";
    partOf = [ "graphical-session.target" ];
    after = [ "graphical-session.target" ];
    wantedBy = [ "graphical-session.target" ];
    serviceConfig.ExecStart = "${pkgs.lxqt.lxqt-policykit}/bin/lxqt-policykit-agent";
  };
{%- endif %}
{%- if wm_packages is defined or desktop_is_tiling %}

  environment.systemPackages = with pkgs; [
{%- if wm_packages is defined %}
    {{ wm_packages }}
{%- endif %}
{%- if desktop_is_tiling %}
{%- if desktop != "hyprland" %}
    pcmanfm
{%- endif %}
    pavucontrol
    mpv
{%- if needs_xserver %}
    xclip
    flameshot
    # dunst owns org.freedesktop.Notifications, so dbus starts it the first time something notifies.
    dunst
{%- else %}
    wl-clipboard
    grim
    slurp
    imv
    # mako owns org.freedesktop.Notifications, so dbus starts it the first time something notifies.
    mako
{%- endif %}
{%- endif %}
  ];
{%- endif %}

  # GTK takes its titlebar buttons from this GNOME key, whose default is close-only.
  programs.dconf.enable = true;
  programs.dconf.profiles.user.databases = [
    {
      settings."org/gnome/desktop/wm/preferences".button-layout = "appmenu:minimize,maximize,close";
    }
  ];
