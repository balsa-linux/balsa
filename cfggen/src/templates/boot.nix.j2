  # The ESP is 1 GiB and each generation copies a kernel and initrd into it.
  boot.loader.limine = {
    enable = true;
    maxGenerations = 10;
{%- if boot.legacy_bios %}
    biosSupport = true;
    biosDevice = "{{ disk.disk | nix }}";
    # On GPT, limine bios-install wants the 1-based index of disko's EF02 partition, which it creates first.
    partitionIndex = 1;
    # Defaults to true on x86_64, which would install the EFI files a BIOS machine never reads.
    efiSupport = false;
{%- else %}
    efiSupport = true;
{%- endif %}
  };
{%- if not boot.legacy_bios %}
  boot.loader.efi.canTouchEfiVariables = true;
  boot.loader.efi.efiSysMountPoint = "{{ boot.esp_mount | nix }}";
{%- endif %}
{%- if disk.filesystem == "btrfs" %}
  services.btrfs.autoScrub.enable = true;
  environment.systemPackages = [ pkgs.compsize ];
{%- endif %}
{%- if disk.filesystem == "zfs" %}
  # Trim is already on by default; a scrub is what verifies the checksums it stores.
  services.zfs.autoScrub.enable = true;
  # nixpkgs' upcoming default; forced import risks importing a pool another system is using.
  boot.zfs.forceImportRoot = false;
  # The by-id default is empty for some disks (e.g. virtio without a serial); disko's GPT always has partuuids.
  boot.zfs.devNodes = "/dev/disk/by-partuuid";
  # File managers offer to mount the pool's member partition, which the kernel can never do.
  services.udev.extraRules = ''
    SUBSYSTEM=="block", ENV{ID_FS_TYPE}=="zfs_member", ENV{UDISKS_IGNORE}="1"
  '';
{%- endif %}
