{%- if effective_loader == "limine" %}
  boot.loader.limine = {
    enable = true;
{%- if boot.legacy_bios %}
    biosSupport = true;
    biosDevice = "{{ disk.disk | nix }}";
{%- else %}
    efiSupport = true;
{%- endif %}
  };
{%- if not boot.legacy_bios %}
  boot.loader.efi.canTouchEfiVariables = true;
  boot.loader.efi.efiSysMountPoint = "{{ boot.esp_mount | nix }}";
{%- endif %}
{%- elif effective_loader == "systemd-boot" %}
  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;
  boot.loader.efi.efiSysMountPoint = "{{ boot.esp_mount | nix }}";
{%- else %}
  boot.loader.grub = {
    enable = true;
{%- if boot.legacy_bios %}
    # boot.loader.grub.devices comes from disko's EF02 partition.
{%- else %}
    efiSupport = true;
    device = "nodev";
{%- endif %}
{%- if boot.dual_boot %}
    useOSProber = true;
{%- endif %}
  };
{%- if not boot.legacy_bios %}
  boot.loader.efi.canTouchEfiVariables = true;
  boot.loader.efi.efiSysMountPoint = "{{ boot.esp_mount | nix }}";
{%- endif %}
{%- endif %}
