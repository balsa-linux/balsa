{
  description = "Balsa system configuration for {{ network.hostname | nix }}";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/{{ nixpkgs_ref | nix }}";
    disko = {
      url = "github:nix-community/disko";
      inputs.nixpkgs.follows = "nixpkgs";
    };
{%- if cachyos %}
    # Never override this input's nixpkgs; the overlay choice selects it.
    cachyos-kernel.url = "{{ cachyos.flake_url }}";
{%- endif %}
{%- if balsa_ref %}
    # Balsa's modules, pinned to the ISO's commit.
    balsa = {
      url = "github:balsa-linux/balsa/{{ balsa_ref | nix }}";
      inputs.nixpkgs.follows = "nixpkgs";
      inputs.disko.follows = "disko";
      # Without this, locking fetches cachyos-kernel and its own nixpkgs on every install.
      inputs.cachyos-kernel.follows = "{% if cachyos %}cachyos-kernel{% endif %}";
    };
{%- endif %}
  };

  outputs = inputs@{ self, nixpkgs, disko, ... }: {
    nixosConfigurations."{{ network.hostname | nix }}" = nixpkgs.lib.nixosSystem {
      specialArgs = { inherit inputs; };
      modules = [
        disko.nixosModules.disko
        ./disko-config.nix
        ./hardware-configuration.nix
        ./configuration.nix
{%- if balsa_ref %}
        inputs.balsa.nixosModules.branding
{%- endif %}
      ];
    };
  };
}
