{
  description = "Balsa system configuration for {{ network.hostname | nix }}";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/{{ nixpkgs_ref | nix }}";
    disko = {
      url = "github:nix-community/disko";
      inputs.nixpkgs.follows = "nixpkgs";
    };
{%- if cachyos %}
    # Never override this input's nixpkgs; the overlay choice selects it.
    cachyos-kernel.url = "{{ cachyos.flake_url }}";
{%- endif %}
  };

  outputs = inputs@{ self, nixpkgs, disko, ... }: {
    nixosConfigurations.test = nixpkgs.lib.nixosSystem {
      specialArgs = { inherit inputs; };
      modules = [
        disko.nixosModules.disko
        ./disko-config.nix
        ./hardware-configuration.nix
        ./configuration.nix
      ];
    };
  };
}
