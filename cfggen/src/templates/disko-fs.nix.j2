{%- if disk.filesystem == "btrfs" %}
              type = "btrfs";
              extraArgs = [ "-f" ];
              subvolumes = {
                "/root" = {
                  mountpoint = "/";
                  mountOptions = [ "compress=zstd" "noatime" ];
                };
                "/home" = {
                  mountpoint = "/home";
                  mountOptions = [ "compress=zstd" "noatime" ];
                };
                "/nix" = {
                  mountpoint = "/nix";
                  mountOptions = [ "compress=zstd" "noatime" ];
                };
              };
{%- elif disk.filesystem == "zfs" %}
              type = "zfs";
              pool = "zroot";
{%- else %}
              type = "filesystem";
              format = "{{ disk.filesystem }}";
              mountpoint = "/";
{%- endif %}
