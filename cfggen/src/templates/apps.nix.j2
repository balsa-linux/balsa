  # lazy.nvim shells out to git and a C compiler, and micro replaces nano under its own name.
  environment.systemPackages = [
    pkgs.git
    # nvim-treesitter compiles each parser on install and wants cc on PATH.
    pkgs.gcc
    pkgs.ripgrep
    pkgs.fd
    # The file managers' "extract here" shells out to these, and xdg-open routes links to Firefox.
    pkgs.unzip
    pkgs.p7zip
    pkgs.xdg-utils
    pkgs.wget
    pkgs.btop
    pkgs.zed-editor
    (pkgs.runCommand "balsa-micro" { nativeBuildInputs = [ pkgs.makeWrapper ]; } ''
      makeWrapper ${pkgs.micro}/bin/micro $out/bin/micro --add-flags "-keymenu true"
      ln -s micro $out/bin/nano
    '')
    (pkgs.writeShellApplication {
      name = "balsa-tune";
      text = ''
        # Specialisations hang off the booted system; switching into one replaces current-system.
        base=/run/booted-system
        profiles=(default)
        # A literal ${'#'} after a brace opens a Tera comment, so the count is tracked by hand.
        count=1
        for d in "$base"/specialisation/*; do
          if [ -d "$d" ]; then
            profiles+=("$(basename "$d")")
            count=$((count + 1))
          fi
        done

        for i in "''${!profiles[@]}"; do
          printf '%d) %s\n' "$((i + 1))" "''${profiles[i]}"
        done

        read -rp "Profile number: " n
        case "$n" in
          "" | *[!0-9]*) echo "Not a number: $n" >&2; exit 1 ;;
        esac
        if [ "$n" -lt 1 ] || [ "$n" -gt "$count" ]; then
          echo "No profile $n" >&2
          exit 1
        fi

        name=''${profiles[$((n - 1))]}
        if [ "$name" = default ]; then
          target=$base
        else
          target=$base/specialisation/$name
        fi

        # Kernel parameters are fixed at boot, so a profile that changes them needs its boot entry.
        if ! diff -q /proc/cmdline "$target/kernel-params" >/dev/null 2>&1; then
          echo "$name sets different kernel parameters; those need a reboot into its entry."
        fi

        read -rp "Switch to $name now? [y/N] " reply
        case "$reply" in
          [yY]) sudo "$target/bin/switch-to-configuration" test ;;
        esac
      '';
    })
    (pkgs.writeShellApplication {
      name = "balsa-pkg";
      runtimeInputs = [ pkgs.nix-search-tv pkgs.fzf pkgs.nix ];
      text = ''
        # nix-search-tv indexes NixOS and home-manager options too, which are not installable.
        choice=$(nix-search-tv print | grep "^nixpkgs/ " \
          | fzf --preview "nix-search-tv preview {}" --scheme history) || exit 0
        attr=''${choice#nixpkgs/ }
        read -rp "Install $attr? [y/N] " reply
        case "$reply" in
          [yY]) nix profile install "nixpkgs#$attr" ;;
        esac
      '';
    })
  ];
  programs.nano.enable = false;

  # Nothing else installs a font, so emoji and CJK render as boxes everywhere.
  fonts.packages = with pkgs; [
    noto-fonts
    noto-fonts-color-emoji
    noto-fonts-cjk-sans
    jetbrains-mono
  ];

  # GNOME turns this on itself; everywhere else the adapter stays dark and pairs nothing.
  hardware.bluetooth.enable = true;
  hardware.bluetooth.powerOnBoot = true;

  # Without CUPS there is no print dialog at all, and avahi is what finds driverless printers.
  services.printing.enable = true;
  services.avahi = {
    enable = true;
    nssmdns4 = true;
    openFirewall = true;
  };

  # Discover and GNOME Software grow a firmware section once this is on.
  services.fwupd.enable = true;

  # Rebuilds land the same files over and over; hardlinking them back costs nothing at rest.
  nix.settings.auto-optimise-store = true;

  # The system flake lives here, so nh rebuilds and prunes without being told where to look.
  programs.nh = {
    enable = true;
    flake = "/etc/nixos";
    clean.enable = true;
    clean.extraArgs = "--keep 5 --keep-since 7d";
  };

  # balsa-pkg and nix shell then resolve nixpkgs# to this system's own nixpkgs, already in the store.
  nix.registry.nixpkgs.flake = inputs.nixpkgs;

  # Flatpak asserts on portals, and the GTK backend covers the desktops that ship none.
  services.flatpak.enable = true;
  xdg.portal.enable = true;
  xdg.portal.extraPortals = [ pkgs.xdg-desktop-portal-gtk ];

  # The module adds no remotes, and an empty Flatpak has nothing to offer.
  systemd.services.balsa-flathub = {
    wantedBy = [ "multi-user.target" ];
    wants = [ "network-online.target" ];
    after = [ "network-online.target" ];
    path = [ pkgs.flatpak ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = "flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo";
  };

  programs.firefox.enable = true;
  xdg.mime.defaultApplications = {
    "text/html" = "firefox.desktop";
    "x-scheme-handler/http" = "firefox.desktop";
    "x-scheme-handler/https" = "firefox.desktop";
  };

  programs.neovim = {
    enable = true;
    defaultEditor = true;
    viAlias = true;
    vimAlias = true;
    configure = {
      # Only lazy.nvim comes from nixpkgs; it fetches LazyVim's plugins on first run.
      customRC = ''
        lua << EOF
        vim.g.mapleader = " "
        vim.g.maplocalleader = "\\"
        -- start packages reach rtp only after init, so lazy cannot load its submodules yet.
        vim.opt.rtp:prepend("${pkgs.vimPlugins.lazy-nvim}")
        require("lazy").setup({
          spec = { { "LazyVim/LazyVim", import = "lazyvim.plugins" } },
          install = { colorscheme = { "tokyonight", "habamax" } },
          lockfile = vim.fn.stdpath("data") .. "/lazy-lock.json",
          performance = { rtp = { reset = false } },
        })
        EOF
      '';
    };
  };
