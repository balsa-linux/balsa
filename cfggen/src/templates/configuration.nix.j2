{ config, lib, pkgs, inputs, ... }:

# One module attrset per fragment, so two concerns can set the same option.
{
  config = lib.mkMerge [
    {
{% include "locale.nix.j2" %}
    }
    {
{% include "boot.nix.j2" %}
    }
    {
{% include "kernel.nix.j2" %}
    }
    {
{% include "hardware.nix.j2" %}
    }
    {
{% include "network.nix.j2" %}
    }
    {
{% include "desktop.nix.j2" %}
    }
    {
{% include "login.nix.j2" %}
    }
    {
{% include "accounts.nix.j2" %}
    }
    {
{% include "swap.nix.j2" %}
    }
    {
{%- set_global specialisation = false %}
{%- set_global profile = tuning_profile %}
{% include "tuning.nix.j2" %}
{%- set_global specialisation = true %}
{%- for p in tuning_specialisations %}
    specialisation.{{ p }}.configuration = {
{%- set_global profile = p %}
{% include "tuning.nix.j2" %}
    };
{%- endfor %}
    }
    {
{% include "shell.nix.j2" %}
    }
    {
{% include "apps.nix.j2" %}
    }
    {
      nix.settings.experimental-features = [ "nix-command" "flakes" ];
      system.stateVersion = "{{ state_version | nix }}";
    }
  ];
}
